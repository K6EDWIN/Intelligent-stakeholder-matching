# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma (src/lib/prisma.js, prisma.config.ts).
# Matches the docker-compose.yml postgres service below if you use it as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stakeholder_matching"

# Secret used to sign NextAuth session tokens (src/lib/auth.js).
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Encrypts Asante Rewards and recent-flight details submitted for manual
# Frequent Flyer record review. Generate once, keep stable, and never commit it.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FREQUENT_FLYER_VERIFICATION_KEY="replace-with-a-base64-encoded-32-byte-key"

# Gmail SMTP credentials for verification and administrator invitation mail.
# Use a Google App Password for strathtank@gmail.com, not the account password.
GMAIL_USER="strathtank@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_gmail_app_password"

# Optional event banner uploads. Create a public Vercel Blob store and add its
# read/write token in Vercel and your local environment to enable this feature.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Canonical public URL used for verification and admin-invitation emails.
# Keep localhost only for local development. In Vercel Production, use the
# stable deployed URL, e.g. https://your-project.vercel.app.
APP_URL="http://localhost:3000"

# Google OAuth Credentials (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Canonical URL of your site (required for NextAuth in production)
NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional hosted Python API (for example Render or a Hugging Face Space).
# Set the same random token in the hosted service's ML_SERVICE_TOKEN setting.
ML_SERVICE_URL="https://your-recommender-service.onrender.com"
ML_SERVICE_TOKEN="replace-with-a-long-random-secret"

# Shared secret used by your private Colab notebook to export training rows
# and publish trained numeric model artifacts. Configure in Vercel Preview
# and as a Colab Secret; never commit the actual value.
ML_COLAB_SYNC_TOKEN="replace-with-a-different-long-random-secret"
# Separate stable secret used only to pseudonymize account IDs for NCF training.
ML_COLAB_USER_SALT="replace-with-another-long-random-secret"
