# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma (src/lib/prisma.js, prisma.config.ts).
# Matches the docker-compose.yml postgres service below if you use it as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stakeholder_matching"

# Secret used to sign NextAuth session tokens (src/lib/auth.js).
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Gmail SMTP credentials for verification and administrator invitation mail.
# Use a Google App Password for strathtank@gmail.com, not the account password.
GMAIL_USER="strathtank@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_gmail_app_password"

# Base URL used to build the email verification link (src/app/api/register/route.js).
# Use your deployed URL in production.
APP_URL="http://localhost:3000"

# Google OAuth Credentials (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Canonical URL of your site (required for NextAuth in production)
NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional hosted Python API (for example Render or a Hugging Face Space).
# Set the same random token in the hosted service's ML_SERVICE_TOKEN setting.
ML_SERVICE_URL="https://your-recommender-service.onrender.com"
ML_SERVICE_TOKEN="replace-with-a-long-random-secret"
