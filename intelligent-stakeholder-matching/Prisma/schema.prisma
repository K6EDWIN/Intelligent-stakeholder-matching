// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum UserRole {
  ALUMNI
  STAFF
  FORMER_STAFF
  FREQUENT_FLYER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MentorshipRole {
  MENTOR
  MENTEE
  BOTH
}

// ---------- CORE USER & PROFILE ----------

// Object: User
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  sessions      AuthSession[]

  // Mentorship requests sent/received
  sentMentorshipRequests     MentorshipRequest[] @relation("MentorshipSender")
  receivedMentorshipRequests MentorshipRequest[] @relation("MentorshipReceiver")

  // Connection requests sent/received
  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionSender")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionReceiver")

  // Recommendations generated for this user
  recommendationsReceived Recommendation[] @relation("RecommendationOwner")
  recommendationsAsMatch  Recommendation[] @relation("RecommendationMatch")

  feedbackGiven Feedback[]

  opportunitiesPosted Opportunity[]
  eventsCreated       Event[]
  eventParticipations EventParticipant[]

  flightReconnects FlightReconnect[]

  // Only populated when role = ADMIN
  adminActions AdminAction[]
}

// Object: Stakeholder Profile (covers Mentor/Mentee profile via mentorshipRole)
model Profile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName             String
  bio                  String?
  department            String?
  professionalBackground String?
  trainingHistory       String?
  careerGoals           String?
  mentorshipNeeds       String?
  mentorshipRole         MentorshipRole?  // Mentor / Mentee / Both — null if not participating
  availability           String?
  isPublic               Boolean         @default(true)

  skills               ProfileSkill[]
  interests            ProfileInterest[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Object: Skill
model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]
}

// Join table: Profile <-> Skill (many-to-many with no extra fields needed yet)
model ProfileSkill {
  profileId String
  skillId   String

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

// Object: Interest
model Interest {
  id       String            @id @default(cuid())
  name     String            @unique
  profiles ProfileInterest[]
}

// Join table: Profile <-> Interest
model ProfileInterest {
  profileId  String
  interestId String

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
}

// ---------- MENTORSHIP & NETWORKING ----------

// Object: Mentorship Request
model MentorshipRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  message    String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender     User @relation("MentorshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("MentorshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  feedback   Feedback[]
}

// Object: Connection Request (general professional networking, not mentorship-specific)
model ConnectionRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender     User @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ---------- RECOMMENDATION ENGINE ----------

// Object: Recommendation — stores the hybrid score per (owner, candidate) pair
model Recommendation {
  id                 String   @id @default(cuid())
  ownerId            String   // the user receiving the recommendation
  matchedUserId      String   // the recommended stakeholder

  contentScore       Float    // content-based filtering score
  collaborativeScore Float    // collaborative filtering score
  hybridScore        Float    // weighted combination (alpha * content + beta * collaborative)

  rank               Int?     // position after ranking, 1 = top match
  createdAt          DateTime @default(now())

  owner              User @relation("RecommendationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  matchedUser        User @relation("RecommendationMatch", fields: [matchedUserId], references: [id], onDelete: Cascade)

  feedback           Feedback[]

  @@unique([ownerId, matchedUserId])
}

// Object: Feedback — user feedback on a recommendation or completed mentorship
model Feedback {
  id               String   @id @default(cuid())
  userId           String
  recommendationId String?
  mentorshipRequestId String?

  rating           Int      // e.g. 1-5
  comment          String?
  createdAt        DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  mentorshipRequest MentorshipRequest? @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)
}

// ---------- OPPORTUNITIES & EVENTS ----------

// Deliverable: Opportunity Sharing Module
model Opportunity {
  id          String   @id @default(cuid())
  postedById  String
  title       String
  description String
  type        String   // e.g. "training", "job", "career development"
  createdAt   DateTime @default(now())

  postedBy    User @relation(fields: [postedById], references: [id], onDelete: Cascade)
}

// Deliverable: Event Management Module
model Event {
  id          String   @id @default(cuid())
  createdById String
  title       String
  description String?
  location    String?
  eventDate   DateTime
  createdAt   DateTime @default(now())

  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants EventParticipant[]
}

// Join table: Event <-> User (attendance)
model EventParticipant {
  eventId String
  userId  String
  joinedAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// ---------- FLIGHT RECONNECT ----------

// Deliverable: Flight Reconnect Module — consent-based reconnection by shared travel
model FlightReconnect {
  id         String   @id @default(cuid())
  userId     String
  flightRoute String  // e.g. "NBO-LHR"
  travelDate DateTime
  consentToShare Boolean @default(false)
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- AUTH & ADMIN ----------

// Object: Authentication Session
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Object: Administrator (actions performed by admins, e.g. verifying users, moderating content)
model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  actionType  String   // e.g. "VERIFY_USER", "REMOVE_CONTENT", "SUSPEND_USER"
  targetId    String?  // id of the affected user/opportunity/event, etc.
  notes       String?
  createdAt   DateTime @default(now())

  admin       User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
